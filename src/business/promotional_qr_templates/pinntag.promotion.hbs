<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>PinnTag QR Page</title>

    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: Arial, Helvetica, sans-serif;
      }

      body {
        background: #111;
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
      }

      .outer-container {
        width: 1748px;
        height: 2480px;
        background: #161616;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding-top: 20px;
        color: #fff;
      }

      .logo {
        display: flex;
        align-items: center;
        gap: 20px;
        margin-bottom: 30px;
        margin-top: 90px;
      }

      .logo img {
        width: 601px;
        height: 186px;
      }

      .logo-text {
        font-size: 48px;
        font-weight: 700;
        letter-spacing: 4px;
      }

      .tagline {
        font-size: 22px;
        font-style: italic;
        opacity: 0.9;
      }

      .headline {
        font-size: 54px;
        text-align: center;
        margin: 60px 0 75px;
        font-weight: bold;
      }

      .card {
        background: #fff;
        width: 1250px;
        height: 1725px;
        border-radius: 40px;
        padding: 40px 60px;
        text-align: center;
        color: #000;
      }

      .place {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 20px;
        font-size: 36px;
        margin-bottom: 30px;
      }

      .place img {
        width: 128px;
        height: 128px;
        border-radius: 50%;
      }

      .place p {
        font-size: 56px;
        font-weight: medium;
      }

      .qr-box {
        background: #ffffff;
        width: 937px;
        height: 937px;
        margin: 40px auto;
        border-radius: 50px;
        border: 1px solid #000;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: column;
        box-shadow: 0 8px 20px rgba(60, 60, 60, 0.5);
        padding: 120px 80px;
      }

      .qr-box img {
        width: 420px;
        height: 420px;
        padding: 0 20px;
      }

      .scan-btn {
        margin-top: 60px;
        background: #2f2f2f;
        color: #fff;
        font-size: 40px;
        padding: 30px 0;
        border-radius: 14px;
        border: none;
        display: flex;
        align-items: center;
        gap: 20px;
        width: 100%;
        justify-content: center;
      }

      .features {
        display: flex;
        justify-content: space-around;
        margin-top: 50px;
        padding: 30px 70px;
      }

      .feature {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        text-align: center;
        height: 187px;
      }

      .feature img {
        width: 180px;
        height: 180px;
        margin-bottom: 10px;
      }

      .feature p {
        font-size: 36px;
        font-weight: bold;
      }

      .bottom-bg {
        width: 100%;
        height: 520px;
        background-repeat: no-repeat;
        background-position: center bottom;
        background-size: cover;
        border-top-left-radius: 500px;
        border-top-right-radius: 500px;
        margin-top: -290px;
        overflow: hidden;
        display: flex;
        justify-content: center;
        align-items: center;
        background-image: url("data:image/png;base64,");
      }

      .bottom-text {
        font-size: 54px;
        font-weight: regular;
        margin-top: 300px;
        color: #fff;
      }
    </style>
  </head>

  <body>
    <div class="outer-container">
      <!-- PINNTAG LOGO (static or make dynamic if you want) -->
      <div class="pinntagLogo">
        <img
          src="data:image/png;base64,"
          alt="PinnTag Logo"
        />
      </div>

      <div class="headline">
        Find local deals, attractions and events, happening now!
      </div>

      <div class="card">
        <div>
          <div class="place">
            <!-- BUSINESS LOGO -->
            <img
              src="{{businessLogo}}"
              alt="{{businessName}} logo"
            />
            <!-- BUSINESS NAME -->
            <p>{{businessName}}</p>
          </div>
        </div>

        <p style="font-size: 54px; font-weight: medium">
          Scan to explore the places on PinnTag
        </p>

        <div class="qr-box">
          <!-- QR CODE IMAGE -->
          <img
            style="width: 90%; height: 90%"
            src="{{qrCode}}"
            alt="QR Code"
          />
          <button class="scan-btn">
            <p style="font-size: 59px; font-weight: medium">Scan me</p>
            <img
              style="width: 100px; height: 70px"
              src="data:image/png;base64,"
              alt="Scan Icon"
            />
          </button>
        </div>

        <div class="features">
          <div class="feature">
            <img
              src="data:image/png;base64,"
              alt="Follow us icon"
            />
            <p>Follow us</p>
          </div>
          <div style="border: 1px solid #878787"></div>
          <div class="feature">
            <img
              src="data:image/png;base64,"
              alt="View menu icon"
            />
            <p>View menu</p>
          </div>
          <div style="border: 1px solid #878787"></div>
          <div class="feature">
            <img
              src="data:image/png;base64,"
              alt="Get offers icon"
            />
            <p>Get offers</p>
          </div>
        </div>

        <div style="margin-top: 100px">
          <p style="font-size: 40px; font-weight: medium; font-style: italic">
            Your local Business on Pinntag
          </p>
        </div>
      </div>

      <div class="bottom-bg">
        <div class="bottom-text">
          Explore {{businessName}} on PinnTag
        </div>
      </div>
    </div>
  </body>
</html>
