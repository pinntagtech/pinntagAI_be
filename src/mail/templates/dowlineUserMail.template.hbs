<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Welcome to PinnTag</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: #f4f4f4;
      margin: 0;
      padding: 0;
    }
    .container {
      max-width: 600px;
      margin: 30px auto;
      background: #ffffff;
      padding: 20px;
      border-radius: 8px;
      box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
    }
    .header {
      background: #007bff;
      color: white;
      text-align: center;
      padding: 15px;
      font-size: 24px;
      font-weight: bold;
      border-top-left-radius: 8px;
      border-top-right-radius: 8px;
    }
    .content {
      padding: 20px;
      text-align: center;
      font-size: 16px;
      color: #333;
    }
    .credentials {
      background: #f8f9fa;
      padding: 15px;
      border-radius: 5px;
      margin: 20px 0;
      font-size: 16px;
    }
    .login-button {
      display: inline-block;
      background: #007bff;
      color: white;
      padding: 12px 20px;
      text-decoration: none;
      border-radius: 5px;
      font-size: 16px;
      margin-top: 20px;
    }
    .footer {
      text-align: center;
      padding: 15px;
      font-size: 14px;
      color: #777;
    }
    .footer a {
      color: #007bff;
      text-decoration: none;
    }
  </style>
</head>
<body>

  <div class="container">
    <div class="header">Welcome to PinnTag</div>
    
    <div class="content">
      <p>Hello {{name}},</p>
      <p>Your account has been successfully created. Below are your login credentials:</p>

      <div class="credentials">
        <p><strong>Email:</strong> {{email}}</p>
        <p><strong>Password:</strong> {{password}}</p>
      </div>

      <p>You can log in using the button below:</p>
      <a href="{{loginLink}}" class="login-button">Login Now</a>
      
      <p>If you did not request this account, please ignore this email or contact support.</p>
    </div>

    {{!-- <div class="footer">
      &copy; {{year}} {{businessName}}. All rights reserved. <br>
      <a href="{{supportLink}}">Contact Support</a>
    </div> --}}
  </div>

</body>
</html>
