# ── App ───────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4001

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:5173

# ── MongoDB ───────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/pinntag_ai
BACKEND_MONGODB_URI=mongodb://localhost:27017/pinntagPreProduction

# ── Backblaze B2 / S3-compatible storage ─────────────────────────
B2_BUCKET_NAME=pinntag-media-staging
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
B2_REGION=us-east-005
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
CDN_DOMAIN=media-staging.pinntag.com

# ── ETL Service ───────────────────────────────────────────────────
ETL_BASE_URL=http://localhost:8000/api/v1/
ETL_API_KEY=
ETL_API_KEY_HEADER_NAME=X-API-Key

# ── AI Services ───────────────────────────────────────────────────
OPENAI_API_KEY=
GOOGLE_GEMINI_API_KEY=
PRUNA_IMAGE_GEN_API_KEY=

# ── Text LLM Provider (utils/llm.ts facade) ──────────────────────
# Which LLM serves text chat completions through the llm.* facade.
#   "openai" — OpenAI API (default)
#   "local"  — self-hosted, OpenAI-compatible endpoint (vLLM / TGI / LiteLLM)
LLM_PROVIDER=openai
# Default chat model when a call omits one.
OPENAI_MODEL=gpt-4o-mini
# If LLM_PROVIDER=local and the local call fails, retry once on this provider.
# Set "none" to disable. Defaults to "openai" when provider is local.
LLM_FALLBACK_PROVIDER=openai

# ── Local LLM (only when LLM_PROVIDER=local) ─────────────────────
# OpenAI-compatible base URL of your self-hosted server, e.g.
#   http://localhost:8000/v1   (vLLM)
LOCAL_LLM_BASE_URL=
# Many local servers ignore the key, but gateways may require it.
LOCAL_LLM_API_KEY=not-needed
# Model id as registered on your local server.
LOCAL_LLM_MODEL=llama-3.3-70b

# ── Embeddings (helpdesk RAG) ────────────────────────────────────
# Embeddings stay on their own provider for consistency — never mix
# embedding models within one vector store. Defaults to OpenAI.
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LOCAL_EMBEDDING_MODEL=bge-m3

# ── Image Generation Provider ────────────────────────────────────
# Choose "pruna" (cost-efficient), "gemini" (Google Gemini Flash),
# or "openai" (gpt-image-1-mini)
IMAGE_GENERATION_PROVIDER=pruna

# ── Redis (review chat answer cache) ─────────────────────────────
# Optional. When set, identical (businessId + question) chat requests are
# served from cache for 24h, bypassing the LLM. If unset or unreachable, the
# cache silently no-ops and every request falls through to the LLM — the
# endpoint never crashes on a Redis failure.
#   e.g. redis://localhost:6379  or  rediss://user:pass@host:6379
REDIS_URL=

# ── Feature Flags ─────────────────────────────────────────────────
ENABLE_IMAGE_GENERATION=false
ENABLE_AI_TEMPLATE_GENERATION=false
# Nightly cron (2am) that pre-warms review summaries for all active
# businesses, so the consumer review chatbot has warm cached summaries.
ENABLE_REVIEW_SUMMARY_REFRESH=false

# ── Facebook OAuth ────────────────────────────────────────────────
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:4001/dashboard/business-profile

# ── Internal API Auth ─────────────────────────────────────────────
ENFORCE_INTERNAL_API_KEY=true
PINNTAG_BACKEND_TO_AI_KEY=change-me
PINNTAG_BACKEND_JWT_SECRET=

# ── Pinntag Backend (outbound from AI service) ───────────────────
# Per-env: https://pre-dev.api.pinntag.com/v1 | https://beta.api.pinntag.com/v1
#         | https://pre-prod.api.pinntag.com/v1 | https://staging.pinntag.com/v1
BACKEND_URL=
PINNTAG_AI_TO_BACKEND_KEY=

# ── HTTP Client ───────────────────────────────────────────────────
HTTP_TIMEOUT_MS=15000
HTTP_RETRIES=2

# ── Logging ───────────────────────────────────────────────────────
USE_PRETTY_LOGS=false
