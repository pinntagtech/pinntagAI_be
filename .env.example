# CORS Configuration
# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:5173,https://pre-dev.api.pinntag.com,https://dev.business.pinntag.com,https://business.pinntag.com

# Feature Flags
# Set to "true" to enable Gemini AI image generation, "false" to disable and use placeholder images
ENABLE_IMAGE_GENERATION=false

# Facebook OAuth Configuration
FACEBOOK_CLIENT_ID=your_facebook_app_id
FACEBOOK_CLIENT_SECRET=your_facebook_app_secret
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/facebook/oauth/callback
