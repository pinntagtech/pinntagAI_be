# ── App ───────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4001

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:5173

# ── MongoDB ───────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/pinntag_ai
BACKEND_MONGODB_URI=mongodb://localhost:27017/pinntagPreProduction

# ── Backblaze B2 / S3-compatible storage ─────────────────────────
B2_BUCKET_NAME=pinntag-media-staging
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
B2_REGION=us-east-005
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
CDN_DOMAIN=media-staging.pinntag.com

# ── ETL Service ───────────────────────────────────────────────────
ETL_BASE_URL=http://localhost:8000/api/v1/
ETL_API_KEY=
ETL_API_KEY_HEADER_NAME=X-API-Key

# ── AI Services ───────────────────────────────────────────────────
OPENAI_API_KEY=
GOOGLE_GEMINI_API_KEY=
PRUNA_IMAGE_GEN_API_KEY=

# ── Image Generation Provider ────────────────────────────────────
# Choose "pruna" (cost-efficient), "gemini" (Google Gemini Flash),
# or "openai" (gpt-image-1-mini)
IMAGE_GENERATION_PROVIDER=pruna

# ── Feature Flags ─────────────────────────────────────────────────
ENABLE_IMAGE_GENERATION=false
ENABLE_AI_TEMPLATE_GENERATION=false

# ── Facebook OAuth ────────────────────────────────────────────────
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:4001/dashboard/business-profile

# ── Internal API Auth ─────────────────────────────────────────────
ENFORCE_INTERNAL_API_KEY=true
PINNTAG_BACKEND_TO_AI_KEY=change-me
PINNTAG_BACKEND_JWT_SECRET=

# ── Pinntag Backend (outbound from AI service) ───────────────────
# Per-env: https://pre-dev.api.pinntag.com/v1 | https://beta.api.pinntag.com/v1
#         | https://pre-prod.api.pinntag.com/v1 | https://staging.pinntag.com/v1
BACKEND_URL=
PINNTAG_AI_TO_BACKEND_KEY=

# ── HTTP Client ───────────────────────────────────────────────────
HTTP_TIMEOUT_MS=15000
HTTP_RETRIES=2

# ── Logging ───────────────────────────────────────────────────────
USE_PRETTY_LOGS=false
