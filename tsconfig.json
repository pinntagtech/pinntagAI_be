{
  "compilerOptions": {
    "module": "es2020",
    "moduleResolution": "node",
    "target": "ES2021",
    "rootDir": "./src",
    "strict": true,
    "types": ["node"],

    // Output
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",

    // Stricter type checking
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Recommended settings
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,

    // 🚫 Remove these to allow extension-less imports
    // "verbatimModuleSyntax": true,
    // "isolatedModules": true
  }
}
